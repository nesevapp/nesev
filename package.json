{
  "name": "nesev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun --hot src/server/index.ts\" \"vite\"",
    "dev:api": "bun --hot src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "mcp": "bun src/mcp/server.ts",
    "eval:chat": "bun src/server/eval/run.ts",
    "eval:feedback": "bun src/server/eval/feedback.ts",
    "service:install": "bun scripts/service.ts install",
    "service:uninstall": "bun scripts/service.ts uninstall",
    "service:status": "bun scripts/service.ts status"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@pdfme/common": "6.2.4",
    "@pdfme/generator": "6.2.4",
    "@pdfme/pdf-lib": "6.2.4",
    "@pdfme/schemas": "6.2.4",
    "@pdfme/ui": "6.2.4",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.2",
    "hono": "4.13.13",
    "lucide-react": "1.56.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
