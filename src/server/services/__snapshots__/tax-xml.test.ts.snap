exports[`UVA XML (U30) monthly UVA with domestic revenue, credit note, reverse charge and ig. Erwerb 1`] = `
"<?xml version="1.0" encoding="iso-8859-1"?>
<ERKLAERUNGS_UEBERMITTLUNG>
	<INFO_DATEN>
		<ART_IDENTIFIKATIONSBEGRIFF>FASTNR</ART_IDENTIFIKATIONSBEGRIFF>
		<IDENTIFIKATIONSBEGRIFF>123456789</IDENTIFIKATIONSBEGRIFF>
		<PAKET_NR>1</PAKET_NR>
		<DATUM_ERSTELLUNG type="datum">2026-10-15</DATUM_ERSTELLUNG>
		<UHRZEIT_ERSTELLUNG type="uhrzeit">09:05:07</UHRZEIT_ERSTELLUNG>
		<ANZAHL_ERKLAERUNGEN>1</ANZAHL_ERKLAERUNGEN>
	</INFO_DATEN>
	<ERKLAERUNG art="U30">
		<SATZNR>1</SATZNR>
		<ALLGEMEINE_DATEN>
			<ANBRINGEN>U30</ANBRINGEN>
			<ZRVON type="jahrmonat">2026-09</ZRVON>
			<ZRBIS type="jahrmonat">2026-09</ZRBIS>
			<FASTNR>123456789</FASTNR>
			<KUNDENINFO>nesev UVA 2026-09</KUNDENINFO>
		</ALLGEMEINE_DATEN>
		<LIEFERUNGEN_LEISTUNGEN_EIGENVERBRAUCH>
			<KZ000 type="kz">1400.00</KZ000>
			<VERSTEUERT>
				<KZ022 type="kz">900.00</KZ022>
				<KZ029 type="kz">500.00</KZ029>
				<KZ057 type="kz">10.00</KZ057>
			</VERSTEUERT>
		</LIEFERUNGEN_LEISTUNGEN_EIGENVERBRAUCH>
		<INNERGEMEINSCHAFTLICHE_ERWERBE>
			<KZ070 type="kz">300.00</KZ070>
			<VERSTEUERT_IGE>
				<KZ072 type="kz">300.00</KZ072>
			</VERSTEUERT_IGE>
		</INNERGEMEINSCHAFTLICHE_ERWERBE>
		<VORSTEUER>
			<KZ060 type="kz">40.00</KZ060>
			<KZ065 type="kz">60.00</KZ065>
			<KZ066 type="kz">10.00</KZ066>
		</VORSTEUER>
	</ERKLAERUNG>
</ERKLAERUNGS_UEBERMITTLUNG>
"
`;

