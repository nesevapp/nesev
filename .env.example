# nesev environment variables – all optional.
#
# nesev runs without any of these: the data folder is chosen in the first-start setup and the server listens on
# 127.0.0.1:3998. Set a variable in your shell, in the service environment, or copy this file to `.env` (Bun loads
# `.env` from the directory you start nesev in). Values below are the defaults.

# --- Server ---------------------------------------------------------------------------------------------------------

# Port of the server (API + web app). The Vite dev proxy, the service installer and the MCP server follow it.
# PORT=3998

# Interface to listen on. nesev has no authentication: don't use 0.0.0.0 or a LAN/public address (see SECURITY.md).
# NESEV_HOST=127.0.0.1

# Extra hostnames (comma-separated) accepted in the Host/Origin header besides localhost, 127.0.0.1, [::1] and a
# specific NESEV_HOST address.
# NESEV_ALLOWED_HOSTS=

# "production" serves the built web app (dist/web) from the server; set by `bun start` and the service.
# NODE_ENV=development

# --- Data -----------------------------------------------------------------------------------------------------------

# Data folder (database, PDFs, receipts, backups). Overrides the folder chosen in the setup.
# Default: "dataDir" from the config file below; else <checkout>/data if it already holds nesev.db; else the setup.
# NESEV_DATA_DIR=

# Folder of the per-user config file (config.json, written by the setup).
# Default: macOS ~/Library/Application Support/nesev, Linux $XDG_CONFIG_HOME/nesev (~/.config/nesev),
# Windows %APPDATA%\nesev. When set, <checkout>/data is never picked up automatically (useful for experiments).
# NESEV_CONFIG_DIR=

# Database file. Default: <data dir>/nesev.db
# NESEV_DB=

# --- MCP server (bun run mcp) ---------------------------------------------------------------------------------------

# Running nesev server, used only by the queue_receipt_analysis tool. Default: http://127.0.0.1:$PORT
# NESEV_API_URL=http://127.0.0.1:3998

# Base URL for links into the web app in tool results. Default: http://localhost:$PORT
# (in development, the Vite URL, e.g. http://localhost:5173)
# NESEV_WEB_URL=http://localhost:3998

# --- Local AI (llama.cpp, whisper.cpp) ------------------------------------------------------------------------------
# Binaries and model paths are set in the app (Einstellungen → Belegerkennung / Assistent / Spracheingabe). These only
# change where nesev looks for GGUF models when the model path is empty (automatic).

# Hugging Face cache (models downloaded with `llama-server -hf …`). Default: $HF_HOME/hub = ~/.cache/huggingface/hub
# HF_HUB_CACHE=
# HF_HOME=

# llama.cpp's own download cache. Default: ~/.cache/llama.cpp
# LLAMA_CACHE=

# Assistant sampling temperature (0–2), for experiments. Default: 0.4
# NESEV_CHAT_TEMPERATURE=0.4

# --- Demo and development -------------------------------------------------------------------------------------------

# Port of `bun run demo` (or use --port). Default: 3999
# DEMO_PORT=3999

# Folders with the official XSDs for optional schema checks in the tests (otherwise downloaded or skipped).
# NESEV_EINVOICE_XSD_DIR=
# NESEV_FINANZONLINE_XSD_DIR=
